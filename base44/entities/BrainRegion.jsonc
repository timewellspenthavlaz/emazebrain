{
  "name": "BrainRegion",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Region Name"
    },
    "level_type": {
      "type": "string",
      "enum": [
        "hemisphere",
        "neuroanatomical",
        "lobe",
        "brodmann_area"
      ],
      "title": "Level Type"
    },
    "hemisphere": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "both"
      ],
      "default": "both",
      "title": "Hemisphere"
    },
    "parent_id": {
      "type": "string",
      "title": "Parent Region ID"
    },
    "parent_name": {
      "type": "string",
      "title": "Parent Region Name"
    },
    "lobe": {
      "type": "string",
      "title": "Lobe"
    },
    "brodmann_area": {
      "type": "string",
      "title": "Brodmann Area Number"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "functional_skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Related Functional Skill IDs"
    },
    "diagnosis_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Related Diagnosis IDs"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "title": "Status"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "name",
    "level_type"
  ]
}