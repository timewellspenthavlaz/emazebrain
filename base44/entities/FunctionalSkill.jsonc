    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "brain_region_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Related Brain Region IDs"
    },
    "brain_region_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
