{
  "name": "GameBackground",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Background Name"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "solid_warm",
        "solid_cold",
        "textured_warm",
        "textured_cold"
      ],
      "title": "Category"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Sort Order"
    }
  },
  "required": [
    "name",
    "image_url",
    "category"
  ]
}